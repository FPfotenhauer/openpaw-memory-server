# OpenPaw Bridge Client example configuration.
# Copy this file to tools/bridge-client/.env locally. Do not commit real tokens.

# Either OPENPAW_API_BASE_URL or OPENPAW_BASE_URL can be used.
OPENPAW_API_BASE_URL=https://yourdomain.com/api

# Existing OpenPaw API bearer token with access to the bridge endpoints.
OPENPAW_BRIDGE_TOKEN=replace-with-the-existing-api-token

# Local command that receives a JSON payload on stdin and writes the reply text
# or {"reply":"..."} to stdout. The included OpenClaw adapter is a reasonable
# default when OpenClaw is installed on the same machine.
OPENPAW_AGENT_COMMAND='python3 tools/bridge-client/openclaw_agent_adapter.py'

# Optional runtime tuning.
OPENPAW_POLL_INTERVAL_SECONDS=3
OPENPAW_REQUEST_TIMEOUT_SECONDS=120
OPENPAW_AGENT_TIMEOUT_SECONDS=600
OPENPAW_LOG_LEVEL=INFO

# Optional image-action support. If this is empty or omitted, the bridge refuses
# store_image_memory actions. Use colon-separated directories.
# OPENPAW_MEDIA_ALLOWED_ROOTS=/home/user/Pictures:/home/user/openpaw-media

# Set to true only if OPENPAW_AGENT_COMMAND must be evaluated by the shell.
# Leaving this off is safer.
OPENPAW_AGENT_COMMAND_SHELL=false

# Optional OpenClaw adapter settings.
OPENPAW_OPENCLAW_COMMAND=openclaw
OPENPAW_OPENCLAW_LOCAL=true
OPENPAW_OPENCLAW_SESSION_PREFIX=openpaw-web
OPENPAW_OPENCLAW_TIMEOUT_SECONDS=600
# OPENPAW_OPENCLAW_AGENT=main
# OPENPAW_OPENCLAW_MODEL=
# OPENPAW_OPENCLAW_THINKING=medium
